# KakaoTalk Integration via Sendbird
# Tasks 0016-0019: KakaoTalk Integration Environment Variables

# Sendbird App Configuration
# Get these from: https://dashboard.sendbird.com/
SENDBIRD_APP_ID=your_sendbird_app_id
SENDBIRD_API_TOKEN=your_sendbird_api_token
SENDBIRD_WEBHOOK_SECRET=your_sendbird_webhook_secret

# Sendbird OAuth Configuration
# Create OAuth app in Sendbird Dashboard → Settings → Business Messaging → KakaoTalk
SENDBIRD_OAUTH_CLIENT_ID=your_sendbird_oauth_client_id
SENDBIRD_OAUTH_CLIENT_SECRET=your_sendbird_oauth_client_secret

# Token Encryption Key (32 characters for AES-256)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KAKAO_ENCRYPTION_KEY=your_32_character_encryption_key_here

# Sendbird Setup Instructions:
# 1. Create Sendbird account: https://dashboard.sendbird.com/auth/signup
# 2. Create new application (Select "Business Messaging" type)
# 3. Enable KakaoTalk Business Messaging in Settings
# 4. Register AlimTalk templates in Business Messaging → Templates:
#    - TASK_ASSIGN_001: Task assignment notification
#    - EXPENSE_STATUS_001: Expense approval/rejection
#    - PROJECT_MILESTONE_001: Project milestone updates
# 5. Configure OAuth app for KakaoTalk connection flow
# 6. Set webhook URL: https://yourdomain.com/api/kakao/webhook
# 7. Copy credentials to .env.local

# Testing:
# - Use Sendbird Dashboard → Business Messaging → Test to send test AlimTalk
# - Monitor webhook events in Sendbird Dashboard → Webhooks → Logs
