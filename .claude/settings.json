{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh"
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/deny_check.sh"
					},
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check_ai_commit.sh"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Write|Edit|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/formatter.sh"
					},
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-tests-for-file.sh",
						"async": true,
						"timeout": 120
					}
				]
			}
		],
		"PreCompact": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "cat \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/critical-rules.txt"
					}
				]
			}
		],
		"Stop": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "prompt",
						"prompt": "Before stopping, quickly verify: 1) Were all requested changes made? 2) Did we follow the output format (Status, Files, Skills Applied, Mobile Checks, Build)? 3) Are there any TODO items still in_progress that I (the AI) can complete right now without user input? If work is complete or is intentionally waiting on user action (e.g. user testing, user approval, user response), that is NOT incomplete. Only flag items I can fix myself. $ARGUMENTS",
						"timeout": 30
					},
					{
						"type": "command",
						"command": "afplay /System/Library/Sounds/Funk.aiff 2>/dev/null || true"
					}
				]
			}
		],
		"Notification": [
			{
				"matcher": "*",
				"hooks": [
					{
						"type": "command",
						"command": "afplay /System/Library/Sounds/Funk.aiff 2>/dev/null || true"
					}
				]
			}
		]
	}
}
